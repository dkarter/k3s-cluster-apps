{
  "mcpServers": {
    "grafana": {
      "type": "stdio",
      "command": "fnox",
      "args": [
        "--config",
        "${CLAUDE_PROJECT_DIR}/fnox.toml",
        "exec",
        "--replace",
        "--",
        "uvx",
        "mcp-grafana==1.3.0",
        "--enabled-tools=datasource,prometheus,loki,navigation",
        "--disable-write"
      ],
      "env": {
        "GRAFANA_URL": "https://grafana.k3s.pro"
      }
    }
  }
}
