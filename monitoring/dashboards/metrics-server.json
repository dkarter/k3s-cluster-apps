{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "datasource", "uid": "grafana" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Metrics Server 0.7.2 target and metrics.k8s.io API availability, Kubelet collection, freshness, workqueues, and runtime health. Built from the live K3s deployment and upstream metric definitions; no canonical upstream dashboard exists.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "targetBlank": true,
      "title": "Metrics Server v0.7.2 source",
      "type": "link",
      "url": "https://github.com/kubernetes-sigs/metrics-server/tree/v0.7.2"
    },
    {
      "targetBlank": true,
      "title": "Kubernetes monitoring mixin dashboards",
      "type": "link",
      "url": "https://github.com/kubernetes-monitoring/kubernetes-mixin/tree/master/dashboards"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "Availability and Traffic",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Prometheus can scrape the authenticated HTTPS Metrics Server target. A missing target is Down.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "text": "Down" },
                "1": { "color": "green", "text": "Up" }
              },
              "type": "value"
            }
          ],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "min(up{namespace=\"kube-system\",pod=~\"metrics-server-.*\"}) or vector(0)",
          "instant": true,
          "legendFormat": "Target",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Metrics Target",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Metrics Server has stored node points and is ready to serve resource metrics. This checks data readiness, while the target panel checks reachability; it does not probe aggregation-layer routing.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "text": "Unavailable" },
                "1": { "color": "green", "text": "Available" }
              },
              "type": "value"
            }
          ],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "(sum(metrics_server_storage_points{namespace=\"kube-system\",pod=~\"metrics-server-.*\",type=\"node\"}) > bool 0) or vector(0)",
          "instant": true,
          "legendFormat": "APIService",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Metrics API Data",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Requests served by Metrics Server's embedded API server. A healthy idle API displays zero.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(apiserver_request_total{namespace=\"kube-system\",pod=~\"metrics-server-.*\",group=\"metrics.k8s.io\"}[$__rate_interval])) or vector(0)",
          "instant": true,
          "legendFormat": "Requests",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "API Request Rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "HTTP 4xx and 5xx responses from the resource metrics API. A healthy zero is explicit.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.001 }
            ]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(apiserver_request_total{namespace=\"kube-system\",pod=~\"metrics-server-.*\",group=\"metrics.k8s.io\",code=~\"4..|5..\"}[$__rate_interval])) or (0 * max(up{namespace=\"kube-system\",pod=~\"metrics-server-.*\"}))",
          "instant": true,
          "legendFormat": "Failures",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "API Failures",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Failed Kubelet scrapes as a percentage of all Metrics Server Kubelet requests. A healthy zero is explicit.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "id": 6,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "100 * (sum(rate(metrics_server_kubelet_request_total{namespace=\"kube-system\",pod=~\"metrics-server-.*\",success=\"false\"}[$__rate_interval])) / clamp_min(sum(rate(metrics_server_kubelet_request_total{namespace=\"kube-system\",pod=~\"metrics-server-.*\"}[$__rate_interval])), 1e-9)) or (0 * max(up{namespace=\"kube-system\",pod=~\"metrics-server-.*\"}))",
          "instant": true,
          "legendFormat": "Failures",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Node Scrape Errors",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Container restarts in the last 24 hours. A healthy zero is explicit.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "id": 7,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"kube-system\",pod=~\"metrics-server-.*\",container=\"metrics-server\"}[24h])) or vector(0)",
          "instant": true,
          "legendFormat": "Restarts",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Restarts (24h)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 8,
      "panels": [],
      "title": "Collection and API Latency",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Metrics Server Kubelet request rate split by success. Idle periods preserve zero.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "normal" }
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 7 },
      "id": 9,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (success) (rate(metrics_server_kubelet_request_total{namespace=\"kube-system\",pod=~\"metrics-server-.*\"}[$__rate_interval])) or on() vector(0)",
          "legendFormat": "success={{success}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Kubelet Scrape Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Kubelet request latency and full collection-cycle duration from Metrics Server histograms.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 8,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 7 },
      "id": 10,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(metrics_server_kubelet_request_duration_seconds_bucket{namespace=\"kube-system\",pod=~\"metrics-server-.*\"}[$__rate_interval]))) or vector(0)",
          "legendFormat": "Kubelet p95",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(metrics_server_manager_tick_duration_seconds_bucket{namespace=\"kube-system\",pod=~\"metrics-server-.*\"}[$__rate_interval]))) or vector(0)",
          "legendFormat": "Collection p95",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Collection Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Resource metrics freshness and embedded metrics.k8s.io API latency percentiles.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 8,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 7 },
      "id": 11,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(metrics_server_api_metric_freshness_seconds_bucket{namespace=\"kube-system\",pod=~\"metrics-server-.*\"}[$__rate_interval]))) or vector(0)",
          "legendFormat": "Freshness p95",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(apiserver_request_duration_seconds_bucket{namespace=\"kube-system\",pod=~\"metrics-server-.*\",group=\"metrics.k8s.io\"}[$__rate_interval]))) or vector(0)",
          "legendFormat": "API p95",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Freshness and API Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Elapsed time since each node's most recent Kubelet request. Metrics Server collects every 15 seconds.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 8,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0,
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 12,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "time() - metrics_server_kubelet_last_request_time_seconds{namespace=\"kube-system\",pod=~\"metrics-server-.*\"}",
          "legendFormat": "{{node}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Node Collection Age",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Current node and container metric points retained by Metrics Server storage.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 13,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (type) (metrics_server_storage_points{namespace=\"kube-system\",pod=~\"metrics-server-.*\"}) or on() vector(0)",
          "legendFormat": "{{type}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Stored Metric Points",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 14,
      "panels": [],
      "title": "Workqueues and Runtime",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Current depth and retry rate for Metrics Server's Kubernetes client workqueues. Healthy empty queues and zero retries remain visible.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 8,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "id": 15,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "workqueue_depth{namespace=\"kube-system\",pod=~\"metrics-server-.*\"} or on() vector(0)",
          "legendFormat": "{{name}} depth",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "rate(workqueue_retries_total{namespace=\"kube-system\",pod=~\"metrics-server-.*\"}[$__rate_interval]) or on() vector(0)",
          "legendFormat": "{{name}} retries/s",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Workqueue Depth and Retries",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Longest active workqueue operation and p95 queue wait time.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 8,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0,
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "id": 16,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "workqueue_longest_running_processor_seconds{namespace=\"kube-system\",pod=~\"metrics-server-.*\"} or on() vector(0)",
          "legendFormat": "{{name}} running",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (name, le) (rate(workqueue_queue_duration_seconds_bucket{namespace=\"kube-system\",pod=~\"metrics-server-.*\"}[$__rate_interval]))) or on() vector(0)",
          "legendFormat": "{{name}} wait p95",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Workqueue Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Metrics Server process uptime, goroutines, and open file descriptor utilization.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 8,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0,
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "A" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          },
          {
            "matcher": { "id": "byFrameRefID", "options": "C" },
            "properties": [{ "id": "unit", "value": "percent" }]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "id": 17,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "time() - process_start_time_seconds{namespace=\"kube-system\",pod=~\"metrics-server-.*\"} or on() vector(0)",
          "legendFormat": "uptime seconds",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "go_goroutines{namespace=\"kube-system\",pod=~\"metrics-server-.*\"} or on() vector(0)",
          "legendFormat": "goroutines",
          "range": true,
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "100 * process_open_fds{namespace=\"kube-system\",pod=~\"metrics-server-.*\"} / process_max_fds{namespace=\"kube-system\",pod=~\"metrics-server-.*\"} or on() vector(0)",
          "legendFormat": "file descriptors %",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "Process and Go Runtime",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Metrics Server container CPU usage.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0,
          "unit": "cores"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 32 },
      "id": 18,
