      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(traefik_entrypoint_requests_total{namespace=\"kube-system\", entrypoint=~\"$entrypoint\", code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(traefik_entrypoint_requests_total{namespace=\"kube-system\", entrypoint=~\"$entrypoint\"}[$__rate_interval])), 0.000001) or vector(0)",
