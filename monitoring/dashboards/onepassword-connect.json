  },
  "description": "1Password Connect 1.7.3 availability, safe API activity, latency, and runtime health. Built from live /metrics output and the official Connect chart 1.17.1; no canonical upstream dashboard is published.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "targetBlank": true,
      "title": "Official Connect chart 1.17.1",
      "type": "link",
      "url": "https://github.com/1Password/connect-helm-charts/tree/connect-1.17.1/charts/connect"
    },
    {
      "targetBlank": true,
      "title": "Official Connect metrics API specification",
      "type": "link",
      "url": "https://github.com/1Password/connect/blob/aac5e44b27570036e6b56e9f5b2a398a824ae5fc/docs/openapi/spec.yaml#L677"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "Service Health",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Prometheus can scrape the chart-generated ServiceMonitor target. A missing target is shown as Down.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "Down"
                },
                "1": {
                  "color": "green",
                  "text": "Up"
                }
              },
              "type": "value"
            }
          ],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "min(up{namespace=\"onepassword-connect\",service=\"onepassword-connect\",endpoint=\"connect-api\"}) or vector(0)",
          "instant": true,
          "legendFormat": "Connect API",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Metrics Target",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "The API readiness probe calls /health, which checks Connect API dependencies including sync and SQLite.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "Not ready"
                },
                "1": {
                  "color": "green",
                  "text": "Ready"
                }
              },
              "type": "value"
            }
          ],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "min(kube_pod_container_status_ready{namespace=\"onepassword-connect\",container=\"connect-api\"}) or vector(0)",
          "instant": true,
          "legendFormat": "API",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "API / Storage Health",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "The sync container readiness probe reports whether the local Connect cache synchronizer is healthy.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "Not ready"
                },
                "1": {
                  "color": "green",
                  "text": "Ready"
                }
              },
              "type": "value"
            }
          ],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "min(kube_pod_container_status_ready{namespace=\"onepassword-connect\",container=\"connect-sync\"}) or vector(0)",
          "instant": true,
          "legendFormat": "Sync",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Cache / Sync Health",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Container restarts during the last 24 hours. A healthy zero is shown explicitly.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"onepassword-connect\",container=~\"connect-api|connect-sync\"}[24h])) or vector(0)",
          "instant": true,
          "legendFormat": "Restarts",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Restarts (24h)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Current API request throughput across all normalized routes. A healthy idle service displays zero.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(secret_service_api_http_method_counts{namespace=\"onepassword-connect\",service=\"onepassword-connect\",endpoint=\"connect-api\"}[$__rate_interval])) or vector(0)",
          "instant": true,
          "legendFormat": "Requests",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Request Rate",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Elapsed time since the Connect API process started. Zero means no matching process metric is available.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 300
              },
              {
                "color": "green",
                "value": 3600
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "id": 7,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "max(time() - process_start_time_seconds{namespace=\"onepassword-connect\",service=\"onepassword-connect\",endpoint=\"connect-api\"}) or vector(0)",
          "instant": true,
          "legendFormat": "Uptime",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Process Uptime",
      "type": "stat"
    },
    {
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 8,
      "options": {
        "content": "### Telemetry coverage\nConnect 1.7.3 does not export HTTP response status or error counters, so an API error rate cannot be calculated safely. It also does not export cache hit/miss or SQLite capacity metrics. The health panels above use the chart's `/health` readiness probes, which cover the API, sync process, and API dependencies such as SQLite. No vault IDs, item IDs, token metadata, or item data are queried or displayed.",
        "mode": "markdown"
      },
      "title": "Errors and Internal Storage",
      "type": "text"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "id": 9,
      "panels": [],
      "title": "API Traffic",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Request rate by HTTP method and normalized route. Connect replaces vault and item IDs with :uuid before exporting labels.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "id": 10,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (method, path) (rate(secret_service_api_http_method_counts{namespace=\"onepassword-connect\",service=\"onepassword-connect\",endpoint=\"connect-api\"}[$__rate_interval])) or on() vector(0)",
          "legendFormat": "{{method}} {{path}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Requests by Route",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Safe activity grouped only by normalized route category; vault and item identifiers never appear in these labels.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "id": 11,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (path) (rate(secret_service_api_http_method_counts{namespace=\"onepassword-connect\",service=\"onepassword-connect\",endpoint=\"connect-api\",path=~\"/v1/vaults|/v1/vaults/:uuid/items|/v1/vaults/:uuid/items/:uuid\"}[$__rate_interval])) or on() vector(0)",
          "legendFormat": "{{path}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Vault and Item Activity",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Request latency percentiles across all normalized API routes.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 19
      },
      "id": 12,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(secret_service_api_http_duration_seconds_bucket{namespace=\"onepassword-connect\",service=\"onepassword-connect\",endpoint=\"connect-api\"}[$__rate_interval]))) or vector(0)",
          "legendFormat": "p50",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(secret_service_api_http_duration_seconds_bucket{namespace=\"onepassword-connect\",service=\"onepassword-connect\",endpoint=\"connect-api\"}[$__rate_interval]))) or vector(0)",
          "legendFormat": "p95",
          "range": true,
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(secret_service_api_http_duration_seconds_bucket{namespace=\"onepassword-connect\",service=\"onepassword-connect\",endpoint=\"connect-api\"}[$__rate_interval]))) or vector(0)",
          "legendFormat": "p99",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "Request Latency",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Mean request duration calculated from the histogram sum and count. Idle periods display zero.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.25
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "id": 13,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "(sum(rate(secret_service_api_http_duration_seconds_sum{namespace=\"onepassword-connect\",service=\"onepassword-connect\",endpoint=\"connect-api\"}[$__rate_interval])) / clamp_min(sum(rate(secret_service_api_http_duration_seconds_count{namespace=\"onepassword-connect\",service=\"onepassword-connect\",endpoint=\"connect-api\"}[$__rate_interval])), 1e-9)) or vector(0)",
          "instant": true,
          "legendFormat": "Mean",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Mean Latency",
      "type": "stat"
    },
