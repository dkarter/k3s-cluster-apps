  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "Controller Availability",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Prometheus scrape health for the SMB plugin and both CSI controller sidecars.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "max(up{namespace=\"kube-system\",pod=~\"csi-smb-controller-.*\",component=\"smb\"}) or vector(0)",
          "instant": true,
          "legendFormat": "smb",
          "range": false,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "max(up{namespace=\"kube-system\",pod=~\"csi-smb-controller-.*\",component=\"provisioner\"}) or vector(0)",
          "instant": true,
          "legendFormat": "provisioner",
          "range": false,
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "max(up{namespace=\"kube-system\",pod=~\"csi-smb-controller-.*\",component=\"resizer\"}) or vector(0)",
          "instant": true,
          "legendFormat": "resizer",
          "range": false,
          "refId": "C"
        }
      ],
      "title": "Metrics Targets",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "kube_deployment_status_replicas_available{namespace=\"kube-system\",deployment=\"csi-smb-controller\"} or vector(0)",
