      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(csi_sidecar_operations_seconds_count{namespace=\"kube-system\",driver_name=\"smb.csi.k8s.io\",grpc_status_code!=\"OK\"}[$__rate_interval])) or vector(0)",
