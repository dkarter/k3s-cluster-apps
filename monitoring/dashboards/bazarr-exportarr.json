            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"media\", pod=~\"bazarr-exportarr-.*\", container=\"main\"}[$__rate_interval]) and on (namespace, pod) up{namespace=\"media\", service=\"bazarr-exportarr\"}) or vector(0)",
          "instant": true,
          "legendFormat": "CPU",
          "range": false,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "sum(container_memory_working_set_bytes{namespace=\"media\", pod=~\"bazarr-exportarr-.*\", container=\"main\"} and on (namespace, pod) up{namespace=\"media\", service=\"bazarr-exportarr\"}) or vector(0)",
          "instant": true,
          "legendFormat": "Memory",
          "range": false,
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "sum(kube_pod_container_status_restarts_total{namespace=\"media\", pod=~\"bazarr-exportarr-.*\", container=\"main\"} and on (namespace, pod) up{namespace=\"media\", service=\"bazarr-exportarr\"}) or vector(0)",
          "instant": true,
          "legendFormat": "Restarts",
          "range": false,
          "refId": "C"
