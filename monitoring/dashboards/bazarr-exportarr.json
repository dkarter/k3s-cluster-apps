  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "targetBlank": true,
      "title": "Upstream Exportarr dashboard",
      "type": "link",
      "url": "https://github.com/onedr0p/exportarr/blob/v2.3.0/examples/grafana/dashboard2.json"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Prometheus can scrape the Bazarr Exportarr ServiceMonitor target.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "Down"
                },
                "1": {
                  "color": "green",
                  "text": "Up"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "min(up{namespace=\"media\", service=\"bazarr-exportarr\"}) or vector(0)",
          "instant": true,
          "legendFormat": "Exporter",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Exporter Availability",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
