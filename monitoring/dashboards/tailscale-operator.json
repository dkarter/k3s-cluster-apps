{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "datasource",
          "uid": "grafana"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Tailscale Kubernetes operator 1.98.9 availability, reconciliation, managed proxy state, Kubernetes API activity, workqueues, and runtime health. Built from the live operator /metrics endpoint and pinned controller-runtime v0.19.4 definitions; no canonical upstream dashboard exists for this release. Identity-bearing Tailscale and API host labels are intentionally excluded.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "targetBlank": true,
      "title": "Official operator metrics documentation",
      "type": "link",
      "url": "https://tailscale.com/docs/kubernetes-operator/manage-and-configure/expose-metrics"
    },
    {
      "targetBlank": true,
      "title": "Tailscale operator v1.98.9 source",
      "type": "link",
      "url": "https://github.com/tailscale/tailscale/tree/v1.98.9/cmd/k8s-operator"
    },
    {
      "targetBlank": true,
      "title": "controller-runtime v0.19.4 metrics",
      "type": "link",
      "url": "https://github.com/kubernetes-sigs/controller-runtime/blob/v0.19.4/pkg/internal/controller/metrics/metrics.go"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "Operator Health",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Prometheus can scrape the operator PodMonitor target. A missing target is shown as Down.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "Down"
                },
                "1": {
                  "color": "green",
                  "text": "Up"
                }
              },
              "type": "value"
            }
          ],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "min(up{namespace=\"tailscale\",job=\"operator\"}) or vector(0)",
          "instant": true,
          "legendFormat": "Operator",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Metrics Target",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Ready operator replicas reported by kube-state-metrics.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "Not ready"
                },
                "1": {
                  "color": "green",
                  "text": "Ready"
                }
              },
              "type": "value"
            }
          ],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "max(kube_deployment_status_replicas_available{namespace=\"tailscale\",deployment=\"operator\"}) or vector(0)",
          "instant": true,
          "legendFormat": "Ready",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Operator Ready",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Reconcile errors during the last 15 minutes. A healthy zero is explicit.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(increase(controller_runtime_reconcile_errors_total{namespace=\"tailscale\",job=\"operator\"}[15m])) or vector(0)",
          "instant": true,
          "legendFormat": "Errors",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Reconcile Errors [15m]",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Kubernetes API responses with 4xx or 5xx status codes during the last 15 minutes. The identifying host label is excluded.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
