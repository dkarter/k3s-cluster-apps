      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(increase(rest_client_requests_total{namespace=\"tailscale\",job=\"operator\",code=~\"4..|5..\"}[15m])) or vector(0)",
          "instant": true,
          "legendFormat": "API errors",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "API Errors [15m]",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Operator container restarts during the last 24 hours. A healthy zero is explicit.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "id": 6,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"tailscale\",pod=~\"operator-.*\",container=\"operator\"}[24h])) or vector(0)",
          "instant": true,
          "legendFormat": "Restarts",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Restarts [24h]",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Desired operator-managed StatefulSet replicas that are not ready. Resource names are not displayed. A healthy zero is explicit.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "id": 7,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "clamp_min((sum(kube_statefulset_replicas{namespace=\"tailscale\"} * on (namespace, statefulset) group_left() kube_statefulset_labels{namespace=\"tailscale\",label_tailscale_com_managed=\"true\"}) or vector(0)) - (sum(kube_statefulset_status_replicas_ready{namespace=\"tailscale\"} * on (namespace, statefulset) group_left() kube_statefulset_labels{namespace=\"tailscale\",label_tailscale_com_managed=\"true\"}) or vector(0)), 0)",
          "instant": true,
          "legendFormat": "Not ready",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Managed Replicas Not Ready",
      "type": "stat"
    },
    {
