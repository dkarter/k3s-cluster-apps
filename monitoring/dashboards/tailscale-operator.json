          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "(histogram_quantile(0.95, sum by (controller, le) (rate(controller_runtime_reconcile_time_seconds_bucket{namespace=\"tailscale\",job=\"operator\"}[$__rate_interval]))) >= 0) or on() vector(0)",
