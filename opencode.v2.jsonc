{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["CLAUDE.md"],
  "share": "disabled",
  "mcp": {
    "servers": {
      "grafana": {
        "type": "local",
        "command": [
          "fnox",
          "exec",
          "--replace",
          "--",
          "uvx",
          "mcp-grafana==1.3.0",
          "--enabled-tools=datasource,prometheus,loki,navigation",
          "--disable-write",
        ],
        "cwd": ".",
        "environment": {
          "GRAFANA_URL": "https://grafana.k3s.pro",
        },
      },
    },
  },
  "formatter": {
    "dprint": {
      "command": ["dprint", "fmt", "$FILE"],
      "extensions": ["ts", "tsx", "js", "jsx", "json", "jsonc", "md", "toml", "yaml", "yml", "ex", "exs"],
    },
  },
}
